// ============================================================
// DETECTION: Password Spray Attack
// MITRE ATT&CK: T1110.003 - Password Spraying
// Severity: Medium / High / Critical
// Data Source: SigninLogs (Azure AD / Entra ID)
// Author: Marvellous Ekwomadu
// Last Updated: 2025
// False Positives: Bulk account provisioning, migration tools
// Tuning: 1 password against 10+ users in 20 minutes
// ============================================================

let timeWindow = 20m;
let minUsersTargeted = 10;
let minFailureRate = 0.8;

SigninLogs
| where TimeGenerated >= ago(2h)
| where ResultType != "0"
| summarize
    UsersTargeted = dcount(UserPrincipalName),
    UserList = make_set(UserPrincipalName, 20),
    DistinctPasswords = dcount(ClientAppUsed),
    FailedAttempts = count(),
    DistinctApps = dcount(AppDisplayName),
    FirstAttempt = min(TimeGenerated),
    LastAttempt = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, timeWindow)
| where UsersTargeted >= minUsersTargeted
| extend
    AttackDuration = LastAttempt - FirstAttempt,
    FailureRate = round(todouble(FailedAttempts) / todouble(UsersTargeted), 2),
    RiskScore = case(
        UsersTargeted >= 50, "Critical",
        UsersTargeted >= 25, "High",
        UsersTargeted >= 10, "Medium",
        "Low"
    ),
    AttackPattern = case(
        UsersTargeted >= 50, "Large scale spray — likely automated tool",
        UsersTargeted >= 25, "Medium scale spray — targeted organisation",
        UsersTargeted >= 10, "Small scale spray — reconnaissance phase",
        "Monitor"
    )
| where FailureRate >= minFailureRate
| project
    TimeGenerated,
    IPAddress,
    UsersTargeted,
    UserList,
    FailedAttempts,
    FailureRate,
    AttackDuration,
    DistinctApps,
    RiskScore,
    AttackPattern,
    FirstAttempt,
    LastAttempt
| sort by UsersTargeted desc
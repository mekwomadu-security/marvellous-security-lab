_GetWatchlist(' create-watch-list')

let Baseline =
_GetWatchlist(' create-watch-list')
| distinct TableName, ColumnName;
let SigninChanges =
SigninLogs
| take 1
| getschema
| project TableName="SigninLogs", CurrentColumn=ColumnName
| join kind=leftanti (
    Baseline
    | where TableName=="SigninLogs"
    | project BaselineColumn=ColumnName
) on $left.CurrentColumn == $right.BaselineColumn;
